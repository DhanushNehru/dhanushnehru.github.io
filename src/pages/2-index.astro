.cube{position:relative;width:0;height:0;transform-style:preserve-3d;transform:rotateX(-26deg) rotateY(-36deg)}
.cube .cubie{position:absolute;left:0;top:0;width:0;height:0;transform-style:preserve-3d}
.cube .face{position:absolute;left:-30px;top:-30px;width:60px;height:60px;background:var(--ink);border:1px solid #000;backface-visibility:hidden;display:grid;place-items:center}
.cube .face i{display:block;width:86%;height:86%;border-radius:5px;background:var(--c);box-shadow:inset 0 -6px 10px #0003}
.opening-board{position:absolute;width:min(64vw,430px);aspect-ratio:1;display:grid;grid-template-columns:repeat(8,minmax(0,1fr));grid-template-rows:repeat(8,minmax(0,1fr));transform:translateY(-6%) rotateX(20deg) rotateZ(-7deg);transform-style:preserve-3d}
.opening-tile{position:relative;display:grid;place-items:center;opacity:0;transform:translate3d(calc((3.5 - var(--f))*22px),calc((3.5 - var(--r))*22px),-120px) scale(.15);transition:transform .8s cubic-bezier(.22,1,.36,1),opacity .6s;transition-delay:calc((var(--r) + var(--f)) * 18ms)}
