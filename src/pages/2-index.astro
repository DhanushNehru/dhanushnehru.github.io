.opening-tile:nth-child(43) .opening-mark{position:absolute;font:clamp(40px,10vw,68px) Georgia,serif;color:var(--ivory);text-shadow:1px 1px 0 var(--copper),2px 3px 5px #0008;transform:translateY(-90px);opacity:0;z-index:1}
