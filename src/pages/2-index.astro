@media(hover:none){.project:hover{transform:none;box-shadow:none}}
@media(prefers-reduced-motion:reduce){.js-reveal [data-reveal],.js-reveal .about-section{opacity:1!important;transform:none!important;clip-path:none!important}.hero:before{animation:none}.progress{display:none}.chessboard{transform:rotateX(18deg) rotateZ(-7deg)}.project:hover,.button:hover span{transform:none}}

/* ---------- Typography ---------- */
:root{--display:'Fraunces',Georgia,'Times New Roman',serif;--body:'Inter',ui-sans-serif,system-ui,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;--mono:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-family:var(--body)}
