.section-heading{position:relative}.section-heading:after{content:'';position:absolute;left:0;right:0;bottom:-20px;height:1px;background:var(--line);transform:scaleX(0);transform-origin:left;transition:transform 1.4s var(--ease) .2s}.section-heading.in:after{transform:scaleX(1)}
.section-heading{margin-bottom:60px}.filters{margin-bottom:var(--s3)}
.about-section{position:relative;overflow:hidden}.about-section:before{content:'';position:absolute;inset:0;background:conic-gradient(color-mix(in srgb,var(--ivory) 4%,transparent) 25%,transparent 0 50%,color-mix(in srgb,var(--ivory) 4%,transparent) 0 75%,transparent 0) 0 0/72px 72px;-webkit-mask-image:linear-gradient(90deg,transparent 45%,#000);mask-image:linear-gradient(90deg,transparent 45%,#000);pointer-events:none}.about-grid{position:relative}
.js-reveal .about-section{clip-path:inset(6% 4% 0 4%);transition:clip-path 1.2s var(--ease)}.js-reveal .about-section.in{clip-path:inset(0)}
