/* cards */
.project{position:relative;transition:border-color .4s,transform .6s var(--ease),box-shadow .6s var(--ease),background .4s}
.project:before{content:'';position:absolute;left:0;top:0;height:2px;width:100%;background:var(--copper);transform:scaleX(0);transform-origin:left;transition:transform .7s var(--ease)}
.project:hover{transform:translateY(-6px);box-shadow:0 30px 60px #0000004d;border-color:var(--hov)}.project:hover:before{transform:scaleX(1)}
.project-piece{transition:transform .6s var(--ease)}.project:hover .project-piece{transform:translateY(-4px) rotate(-8deg) scale(1.15)}
.project h3 a:hover span{transform:translate(4px,-4px)}
.terminal-cursor{animation:caret 1s steps(1) infinite}@keyframes caret{50%{opacity:0}}
.scanner div{animation:scan 2.8s var(--ease) infinite alternate}@keyframes scan{from{transform:scaleX(.2);opacity:.5}to{transform:scaleX(1);opacity:1}}
.project-art:after{content:'';position:absolute;inset:0;background:linear-gradient(105deg,transparent 40%,color-mix(in srgb,var(--ivory) 5%,transparent) 50%,transparent 60%);transform:translateX(-120%);transition:transform 1s var(--ease)}.project:hover .project-art:after{transform:translateX(120%)}
.routes b,.transfer b{display:inline-block;animation:nudge 2.4s ease-in-out infinite}@keyframes nudge{50%{transform:translateX(5px)}}
