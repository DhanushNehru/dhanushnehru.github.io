/* ---------- Motion + consistency layer ---------- */
:root{interpolate-size:allow-keywords;--ease:cubic-bezier(.22,1,.36,1);--s1:8px;--s2:16px;--s3:24px;--s4:40px;--s5:64px;font-family:'Inter',ui-sans-serif,system-ui,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
html,body{overflow-x:clip}body{line-height:1.5;font-feature-settings:'ss01','cv11'}
h1,h2,h3{text-wrap:balance}p{text-wrap:pretty}
.tiny-label,.eyebrow,.project-foot,.board-top,.project-top,.project-tag,.board-caption{font-variant-numeric:tabular-nums}
.progress{position:fixed;left:0;top:0;height:3px;width:100%;background:linear-gradient(90deg,var(--copper),var(--ivory));transform:scaleX(var(--p,0));transform-origin:left;z-index:90;pointer-events:none}
.header{position:sticky;top:0;z-index:80;background:transparent;transition:height .4s var(--ease)}
.header:before{content:'';position:absolute;inset:0 -50vw;z-index:-1;background:color-mix(in srgb,var(--ink) 96%,transparent);backdrop-filter:blur(14px) saturate(1.2);-webkit-backdrop-filter:blur(14px) saturate(1.2);box-shadow:0 1px 0 var(--line);opacity:0;transition:opacity .4s}.header.scrolled:before{opacity:1}.header.scrolled{height:72px}
.header.scrolled .brand-mark{font-size:34px}.brand-logo{display:block;width:44px;height:44px;border-radius:50%;transition:width .4s var(--ease),height .4s var(--ease)}.header.scrolled .brand-logo{width:34px;height:34px}.footer .brand-logo{width:40px;height:40px}.brand-mark{transition:font-size .4s var(--ease)}
.header-wrap{width:100%}
nav a{position:relative}nav a:after{content:'';position:absolute;left:2px;right:2px;bottom:6px;height:1px;background:var(--copper);transform:scaleX(0);transform-origin:left;transition:transform .45s var(--ease)}nav a:hover:after,nav a.active:after{transform:scaleX(1)}nav a.active{color:var(--copper)}
/* opening sequence */
@keyframes rise{from{opacity:0;transform:translateY(28px)}to{opacity:1;transform:none}}
@keyframes boardIn{from{opacity:0;transform:translateY(40px) scale(.96)}to{opacity:1;transform:none}}
@keyframes settle{from{opacity:0;transform:rotateX(52deg) rotateZ(-22deg) scale(.9)}to{opacity:1}}
.hero-copy>*{animation:rise .9s var(--ease) both}.hero-copy>:nth-child(1){animation-delay:.05s}.hero-copy>:nth-child(2){animation-delay:.15s}.hero-copy>:nth-child(3){animation-delay:.25s}.hero-copy>:nth-child(4){animation-delay:.33s}.hero-copy>:nth-child(5){animation-delay:.41s}.hero-copy>:nth-child(6){animation-delay:.5s}
.board-panel{animation:boardIn 1.1s .2s var(--ease) both}.chessboard{animation:settle 1.4s .35s var(--ease) both}
.chessboard{transform:rotateX(calc(18deg + var(--ty,0deg))) rotateZ(calc(-7deg + var(--tx,0deg)));transition:transform .5s var(--ease)}
.hero{position:relative}
.hero:before{content:'';position:absolute;inset:0 -10vw;z-index:-1;background:conic-gradient(color-mix(in srgb,var(--ivory) 3%,transparent) 25%,transparent 0 50%,color-mix(in srgb,var(--ivory) 3%,transparent) 0 75%,transparent 0) 0 0/96px 96px;-webkit-mask-image:radial-gradient(ellipse 60% 70% at 70% 45%,#000,transparent 75%);mask-image:radial-gradient(ellipse 60% 70% at 70% 45%,#000,transparent 75%);animation:drift 40s linear infinite}
@keyframes drift{to{background-position:192px 96px}}
.board-glow{animation:pulse 6s ease-in-out infinite}@keyframes pulse{50%{opacity:.45;transform:scale(1.15)}}
.dot{animation:blip 2.4s ease-in-out infinite}@keyframes blip{50%{box-shadow:0 0 0 7px color-mix(in srgb,var(--jade) 0%,transparent),0 0 14px color-mix(in srgb,var(--jade) 67%,transparent);transform:scale(1.25)}}
/* board interactions */
.square{transition:background .3s var(--ease),box-shadow .3s}
.square.legal:after{animation:legalPing 2.2s ease-in-out infinite;transition:transform .3s var(--ease)}
.square.legal:hover:after{transform:scale(1.6);animation:none}
@keyframes legalPing{50%{box-shadow:0 0 0 9px color-mix(in srgb,var(--copper) 0%,transparent);transform:scale(1.12)}}
.square.visited:not(.occupied){box-shadow:inset 0 0 0 100px color-mix(in srgb,var(--copper) 15%,transparent)}
.square .ripple{position:absolute;inset:0;border:2px solid var(--copper);pointer-events:none;animation:ripple .8s var(--ease) forwards}
@keyframes ripple{from{opacity:.9;transform:scale(.4)}to{opacity:0;transform:scale(1.5)}}
.board-bottom button{transition:transform .5s var(--ease),background .3s,color .3s}.board-bottom button:hover{background:var(--copper);color:var(--ink);transform:rotate(-200deg)}
#board-status{transition:opacity .2s}
/* buttons + links */
.button{position:relative;overflow:hidden;isolation:isolate}
