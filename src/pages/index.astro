#board-status{transition:opacity .2s}
/* buttons + links */
.button{position:relative;overflow:hidden;isolation:isolate}
.button:before{content:'';position:absolute;inset:0;background:var(--ivory);transform:translateY(101%);transition:transform .5s var(--ease);z-index:-1}
.primary:hover{background:var(--copper)}.button:hover:before{transform:none}
