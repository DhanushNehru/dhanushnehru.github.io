 {name:'lockcheck', cat:'Security', no:'01', piece:'♜', tag:'Supply-chain defense', desc:'A zero-dependency Node.js CLI that reviews lockfile changes for suspicious dependency patterns.', detail:'Typosquats, registry anomalies, integrity changes and install scripts, surfaced before they reach production.', tech:'Node.js / CLI / DevSecOps', url:'https://github.com/DhanushNehru/lockcheck'},
 {name:'TachyRoute', cat:'AI', no:'02', piece:'♞', tag:'Adaptive AI decisions', desc:'An open-source decision engine for typed choices, scores and booleans instead of generated text.', detail:'Explores adaptive early-exit computing and attention-based evidence extraction for explainable routing.', tech:'Python / Machine learning', url:'https://github.com/DhanushNehru/tachyroute'},
 {name:'agentcheck', cat:'Security', no:'03', piece:'♝', tag:'Safer agent workflows', desc:'A CLI that scans AI coding-agent configuration files for hidden instructions and risky patterns.', detail:'Checks instruction files, invisible Unicode, dangerous commands and MCP configurations. Findings support review, not a safety guarantee.', tech:'Node.js / Static analysis', url:'https://github.com/DhanushNehru/agentcheck'},
 {name:'OpenDrop', cat:'Web', no:'04', piece:'♟', tag:'Peer-to-peer by design', desc:'A file-sharing tool for direct device-to-device transfers over your local network.', detail:'WebRTC data channels carry local transfers, with a lightweight signaling server for connection setup and a separate share-link mode.', tech:'WebRTC / JavaScript / Node.js', url:'https://github.com/DhanushNehru/OpenDrop'},
