/* board interactions */
.square{transition:background .3s var(--ease),box-shadow .3s}
.square.legal:after{animation:legalPing 2.2s ease-in-out infinite;transition:transform .3s var(--ease)}
.square.legal:hover:after{transform:scale(1.6);animation:none}
